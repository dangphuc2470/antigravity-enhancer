{
  "name": "antigravity-enhancer",
  "displayName": "Antigravity Enhancer",
  "description": "Essential UX enhancements and native workflow patches for Google Antigravity IDE: instant clipboard paste, seamless cross-workspace switching, conversation forking, workspace chat tabs, auto-submit permission prompts, and notification focus.",
  "version": "1.5.2",
  "publisher": "dangphuc2470",
  "author": {
    "name": "dangphuc2470",
    "email": "dangnguyenhoangphuc1@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dangphuc2470/antigravity-enhancer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity-enhancer.apply",
        "category": "Antigravity Enhancer",
        "title": "Apply All Enhancements & Sync Checksums"
      },
      {
        "command": "antigravity-enhancer.remove",
        "category": "Antigravity Enhancer",
        "title": "Remove All Enhancements (Restore Original)"
      },
      {
        "command": "antigravity-enhancer.fixChecksums",
        "category": "Antigravity Enhancer",
        "title": "Dismiss Corrupted Warning (Sync Checksums)"
      },
      {
        "command": "agi-chat-fix.apply",
        "category": "Antigravity Enhancer",
        "title": "Apply All Enhancements & Sync Checksums (Legacy Alias)"
      },
      {
        "command": "agi-chat-fix.remove",
        "category": "Antigravity Enhancer",
        "title": "Remove All Enhancements (Legacy Alias)"
      },
      {
        "command": "agi-chat-fix.fixChecksums",
        "category": "Antigravity Enhancer",
        "title": "Dismiss Corrupted Warning (Legacy Alias)"
      },
      {
        "command": "antigravity-enhancer.openExternal",
        "category": "Antigravity Enhancer",
        "title": "Open with Default Application"
      }
    ],
    "customEditors": [
      {
        "viewType": "antigravity-enhancer.externalOpener",
        "displayName": "Open with Default Application",
        "selector": [
          {
            "filenamePattern": "*.{exe,msi,doc,docx,docm,dotx,dotm,rtf,xls,xlsx,xlsm,xlsb,xltx,xltm,ppt,pptx,pptm,pps,ppsx,vsd,vsdx,one,pdf,zip,rar,7z,tar,gz,bz2,xz,iso,mp4,mkv,avi,mov,wmv,flv,webm,m4v,mp3,wav,flac,aac,m4a,ogg,wma,psd,ai,blend,fbx,obj,stl,3ds,c4d,max,apk,aab,ipa,dmg,pkg}"
          }
        ],
        "priority": "default"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity-enhancer.openExternal",
        "key": "alt+o",
        "when": "filesExplorerFocus || editorFocus"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "antigravity-enhancer.openExternal",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "antigravity-enhancer.openExternal",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Enhancer",
      "properties": {
        "antigravity-enhancer.externalOpener.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable external file viewer tab for binary and external files (e.g. .exe, Office documents, archives, media)."
        },
        "antigravity-enhancer.externalOpener.disabledExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of file extensions to exclude from automatic external opening (e.g. [\"zip\", \"pdf\"])."
        },
        "antigravity-enhancer.externalOpener.autoCloseTab": {
          "type": "boolean",
          "default": false,
          "description": "Automatically close the editor tab after launching the file with the external application."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx -y @vscode/vsce package --no-dependencies --allow-star-activation"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.3"
  }
}
